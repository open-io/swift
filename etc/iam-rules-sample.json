{
    "demo:demo": {
        "Statement": [
            {
                "Sid": "FullAccess",
                "Action": [
                    "s3:*"
                ],
                "Effect": "Allow",
                "Resource": [
                    "*"
                ]
            }
        ]
    },
    "demo:user1": {
        "Statement": [
            {
                "Sid": "User1BucketAllObjects",
                "Action": [
                    "s3:ListBucket",
                    "s3:ListBucketVersions",
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::user1bucket*",
                    "arn:aws:s3:::user1bucket*/*"
                ]
            },
            {
                "Sid": "SharedBucketUser1Objects",
                "Action": [
                    "s3:GetObject",
                    "s3:PutObject",
                    "s3:DeleteObject"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::sharedbucket/user1_*"
                ]
            },
            {
                "Sid": "SharedBucketAllObjects",
                "Action": [
                    "s3:GetObject",
                    "s3:ListBucket",
                    "s3:GetIntelligentTieringConfiguration",
                    "s3:PutIntelligentTieringConfiguration",
                    "s3:GetBucketTagging",
                    "s3:PutBucketTagging"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::sharedbucket",
                    "arn:aws:s3:::sharedbucket/*"
                ]
            },
            {
                "Sid": "NavToUserFolder",
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::companybucket",
                "Condition": {"StringEquals":{"s3:prefix":["", "home/", "home/user1/"]}}
            },
            {
                "Sid": "UserFolder",
                "Action": "s3:ListBucket",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::companybucket",
                "Condition": {"StringLike":{"s3:prefix":["home/user1/*"]}}
            },
            {
                "Sid": "UserFolderObjects",
                "Action": ["s3:*"],
                "Effect": "Allow",
                "Resource": ["arn:aws:s3:::companybucket/home/user1/*"]
            },
            {
                "Sid": "objectlockconfiguration",
                "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketObjectLockConfiguration",
                    "s3:PutBucketObjectLockConfiguration"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::shared-bucket-config",
                    "arn:aws:s3:::shared-bucket-config/*"
                ]
            },
            {
                "Sid": "legal-hold",
                "Action": [
                    "s3:GetObject",
                    "s3:ListBucket",
                    "s3:GetObjectLegalHold",
                    "s3:PutObjectLegalHold"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::shared-bucket-hold",
                    "arn:aws:s3:::shared-bucket-hold/obj*"
                ]
            },
            {
                "Sid": "retention",
                "Action": [
                    "s3:GetObject",
                    "s3:ListBucket",
                    "s3:GetObjectRetention",
                    "s3:PutObjectRetention"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::shared-bucket-retention",
                    "arn:aws:s3:::shared-bucket-retention/obj-retention*"
                ]
            },
            {
                "Sid": "bypass",
                "Action": [
                    "s3:GetObject",
                    "s3:ListBucket",
                    "s3:BypassGovernanceRetention"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::shared-bucket-bypass",
                    "arn:aws:s3:::shared-bucket-bypass/obj-delete*"
                ]
            },
            {
                "Sid": "versions",
                "Action": [
                    "s3:ListBucketVersions"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::versions-bucket"
                ]
            },
            {
                "Sid": "ComplexPrefixesList",
                "Action": [
                    "s3:ListBucket",
                    "s3:GetBucketLocation",
                    "s3:ListBucketMultipartUploads"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::complexbucket"
                ],
                "Condition": {
                  "StringLike": {
                    "s3:prefix": [
                      "*/????????-????-????-????-????????????/????????-????-????-????-????????????",
                      "*/????????-????-????-????-????????????/????????-????-????-????-????????????/*"
                    ]
                  }
                }
            },
            {
                "Sid": "ComplexPrefixesRW",
                "Action": [
                  "s3:GetObject",
                  "s3:DeleteObject",
                  "s3:PutObject",
                  "s3:AbortMultipartUpload",
                  "s3:ListMultipartUploadParts"
                ],
                "Effect": "Allow",
                "Resource": [
                  "arn:aws:s3:::complexbucket/*/????????-????-????-????-????????????/????????-????-????-????-????????????/*"
                ]
            }
        ]
    },
    "demo:user3": {
        "Statement": [
            {
                "Sid": "AllowAllFromWhitelistedIp",
                "Effect": "Allow",
                "Principal": "*",
                "Action": "s3:*",
                "Resource": [
                    "arn:aws:s3:::s3api-test-bkt-a-listed-ip*",
                    "arn:aws:s3:::s3api-test-bkt-a-listed-ip*/*"
                ],
                "Condition": {
                    "IpAddress": {
                        "aws:SourceIp": "127.0.0.1"
                    }
                }
            },
            {
                "Sid": "DenyAllFromBlacklistedIp",
                "Effect": "Allow",
                "Principal": "*",
                "Action": "s3:*",
                "Resource": [
                    "arn:aws:s3:::s3api-test-bkt-a-nb-listed-ip*",
                    "arn:aws:s3:::s3api-test-bkt-a-nb-listed-ip*/*"
                ],
                "Condition": {
                    "NotIpAddress": {
                        "aws:SourceIp": "127.0.0.88"
                    }
                }
            },
            {
                "Sid": "DenyNonWhitelistedIp",
                "Effect": "Deny",
                "Principal": "*",
                "Action": "s3:*",
                "Resource": [
                    "arn:aws:s3:::s3api-test-bkt-d-nw-listed-ip*",
                    "arn:aws:s3:::s3api-test-bkt-d-nw-listed-ip*/*"
                ],
                "Condition": {
                    "NotIpAddress": {
                        "aws:SourceIp": [
                            "127.0.0.1"
                    ]
                    }
                }
            },
            {
                "Sid": "ExplicitDenyFromIp",
                "Effect": "Deny",
                "Principal": "*",
                "Action": "s3:*",
                "Resource": [
                    "arn:aws:s3:::s3api-test-bkt-d-listed-ip*",
                    "arn:aws:s3:::s3api-test-bkt-d-listed-ip*/*"
                ],
                "Condition": {
                    "IpAddress": {
                        "aws:SourceIp": "127.0.0.88"
                    }
                }
            },
            {
                "Sid": "ExplicitAllowAndDenyFromIp",
                "Effect": "allow",
                "Principal": "*",
                "Action": "s3:*",
                "Resource": [
                    "arn:aws:s3:::s3api-test-bkt-ad-listed-ip*",
                    "arn:aws:s3:::s3api-test-bkt-ad-listed-ip*/*"
                ],
                "Condition": {
                    "IpAddress": {
                        "aws:SourceIp": "127.0.0.1"
                    },
                    "NotIpAddress": {
                        "aws:SourceIp": "127.0.0.88"
                    }
                }
            },
            {
                "Sid": "ExplicitDenyAndAllowFromIp",
                "Effect": "Deny",
                "Principal": "*",
                "Action": "s3:*",
                "Resource": [
                    "arn:aws:s3:::s3api-test-bkt-da-listed-ip*",
                    "arn:aws:s3:::s3api-test-bkt-da-listed-ip*/*"
                ],
                "Condition": {
                    "IpAddress": {
                        "aws:SourceIp": "127.0.0.88"
                    },
                    "NotIpAddress": {
                        "aws:SourceIp": "127.0.0.1"
                    }
                }
            }
        ]
    },
    "account2:admin": {
        "Statement": [
            {
                "Sid": "FullAccess",
                "Action": [
                    "s3:AbortMultipartUpload",
                    "s3:BypassGovernanceRetention",
                    "s3:CreateBucket",
                    "s3:DeleteBucket",
                    "s3:DeleteBucketTagging",
                    "s3:DeleteBucketWebsite",
                    "s3:DeleteIntelligentTieringConfiguration",
                    "s3:DeleteObject",
                    "s3:DeleteObjectTagging",
                    "s3:GetBucketAcl",
                    "s3:GetBucketCORS",
                    "s3:GetBucketLocation",
                    "s3:GetBucketLogging",
                    "s3:GetBucketObjectLockConfiguration",
                    "s3:GetBucketTagging",
                    "s3:GetBucketVersioning",
                    "s3:GetBucketWebsite",
                    "s3:GetEncryptionConfiguration",
                    "s3:GetIntelligentTieringConfiguration",
                    "s3:GetLifecycleConfiguration",
                    "s3:GetObject",
                    "s3:GetObjectAcl",
                    "s3:GetObjectLegalHold",
                    "s3:GetObjectRetention",
                    "s3:GetObjectTagging",
                    "s3:GetReplicationConfiguration",
                    "s3:ListAllMyBuckets",
                    "s3:ListBucket",
                    "s3:ListBucketMultipartUploads",
                    "s3:ListBucketVersions",
                    "s3:ListMultipartUploadParts",
                    "s3:PutBucketAcl",
                    "s3:PutBucketCORS",
                    "s3:PutBucketLogging",
                    "s3:PutBucketObjectLockConfiguration",
                    "s3:PutBucketTagging",
                    "s3:PutBucketVersioning",
                    "s3:PutBucketWebsite",
                    "s3:PutEncryptionConfiguration",
                    "s3:PutIntelligentTieringConfiguration",
                    "s3:PutLifecycleConfiguration",
                    "s3:PutObject",
                    "s3:PutObjectAcl",
                    "s3:PutObjectLegalHold",
                    "s3:PutObjectRetention",
                    "s3:PutObjectTagging",
                    "s3:PutReplicationConfiguration"
                ],
                "Effect": "Allow",
                "Resource": [
                    "*"
                ]
            }
        ]
    },
    "account2:user1": {
        "Statement": [
            {
                "Sid": "SharedBucketAllObjects",
                "Action": [
                    "s3:GetBucketAcl",
                    "s3:GetObject",
                    "s3:ListBucket",
                    "s3:PutBucketAcl"
                ],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::sharedbucket",
                    "arn:aws:s3:::sharedbucket/*"
                ]
            },
            {
                "Sid": "UserBuckets",
                "Action": ["s3:*"],
                "Effect": "Allow",
                "Resource": [
                    "arn:aws:s3:::user1*",
                    "arn:aws:s3:::user1*/*"
                ]
            },
            {
                "Sid": "ListAllMyBuckets",
                "Action": ["s3:ListAllMyBuckets"],
                "Effect": "Deny",
                "Resource": [
                    "arn:aws:s3:::*"
                ]
            }
        ]
    }
}
