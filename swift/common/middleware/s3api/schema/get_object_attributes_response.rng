<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <include href="common.rng"/>
  <start>
    <element name="GetObjectAttributesResponse">
      <optional>
        <element name="ETag">
          <data type="string"/>
        </element>
      </optional>
      <optional>
        <element name="Checksum">
          <interleave>
            <optional>
              <element name="ChecksumCRC32">
                <data type="string"/>
              </element>
            </optional>
            <optional>
              <element name="ChecksumCRC32C">
                <data type="string"/>
              </element>
            </optional>
            <optional>
              <element name="ChecksumCRC64NVME">
                <data type="string"/>
              </element>
            </optional>
            <optional>
              <element name="ChecksumSHA1">
                <data type="string"/>
              </element>
            </optional>
            <optional>
              <element name="ChecksumSHA256">
                <data type="string"/>
              </element>
            </optional>
            <optional>
              <element name="ChecksumType">
                <data type="string"/>
              </element>
            </optional>
          </interleave>
        </element>
      </optional>
      <optional>
        <element name="ObjectParts">
          <element name="PartsCount">
            <data type="int"/>
          </element>
          <optional>
            <element name="IsTruncated">
              <data type="boolean"/>
            </element>
          </optional>
          <optional>
            <element name="MaxParts">
              <data type="int"/>
            </element>
          </optional>
          <optional>
            <element name="PartNumberMarker">
              <data type="int"/>
            </element>
          </optional>
          <optional>
            <element name="NextPartNumberMarker">
              <data type="int"/>
            </element>
          </optional>
          <zeroOrMore>
            <element name="Part">
              <element name="PartNumber">
                <data type="int"/>
              </element>
              <element name="Size">
                <data type="long"/>
              </element>
              <optional>
                <element name="ChecksumCRC32">
                  <data type="string"/>
                </element>
              </optional>
              <optional>
                <element name="ChecksumCRC32C">
                  <data type="string"/>
                </element>
              </optional>
              <optional>
                <element name="ChecksumCRC64NVME">
                  <data type="string"/>
                </element>
              </optional>
              <optional>
                <element name="ChecksumSHA1">
                  <data type="string"/>
                </element>
              </optional>
              <optional>
                <element name="ChecksumSHA256">
                  <data type="string"/>
                </element>
              </optional>
            </element>
          </zeroOrMore>
        </element>
      </optional>
      <optional>
        <element name="StorageClass">
          <data type="string"/>
        </element>
      </optional>
      <optional>
        <element name="ObjectSize">
          <data type="long"/>
        </element>
      </optional>
    </element>
  </start>
</grammar>
