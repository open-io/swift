<?xml version="1.0" encoding="UTF-8"?>
<grammar xmlns="http://relaxng.org/ns/structure/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <element name="RestoreRequest">
      <element name="Days">
        <data type="positiveInteger"/>
      </element>

      <optional>
        <element name="GlacierJobParameters">
          <element name="Tier">
            <choice>
              <value>Standard</value>
              <value>Bulk</value>
              <value>Expedited</value>
            </choice>
          </element>
        </element>
      </optional>

      <optional>
        <element name="Description">
          <data type="string"/>
        </element>
      </optional>

      <optional>
        <element name="OutputLocation">
          <element name="S3">

            <element name="AccessControlList">
              <zeroOrMore>
                <element name="Grant">
                  <element name="Grantee">
                    <optional>
                      <element name="DisplayName">
                        <data type="string"/>
                      </element>
                    </optional>
                    <optional>
                      <element name="EmailAddress">
                        <data type="string"/>
                      </element>
                    </optional>
                    <optional>
                      <element name="ID">
                        <data type="string"/>
                      </element>
                    </optional>
                    <optional>
                      <attribute name="xsi:type">
                        <data type="string"/>
                      </attribute>
                    </optional>
                    <optional>
                      <element name="URI">
                        <data type="string"/>
                      </element>
                    </optional>
                  </element>
                  <element name="Permission">
                    <data type="string"/>
                  </element>
                </element>
              </zeroOrMore>
            </element>

            <element name="BucketName">
              <data type="string"/>
            </element>

            <optional>
              <element name="CannedACL">
                <data type="string"/>
              </element>
            </optional>

            <optional>
              <element name="Encryption">
                <element name="EncryptionType">
                  <data type="string"/>
                </element>
                <optional>
                  <element name="KMSContext">
                    <data type="string"/>
                  </element>
                </optional>
                <optional>
                  <element name="KMSKeyId">
                    <data type="string"/>
                  </element>
                </optional>
              </element>
            </optional>

            <optional>
              <element name="Prefix">
                <data type="string"/>
              </element>
            </optional>

            <optional>
              <element name="StorageClass">
                <data type="string"/>
              </element>
            </optional>

            <optional>
              <element name="Tagging">
                <element name="TagSet">
                  <oneOrMore>
                    <element name="Tag">
                      <element name="Key">
                        <data type="string"/>
                      </element>
                      <element name="Value">
                        <data type="string"/>
                      </element>
                    </element>
                  </oneOrMore>
                </element>
              </element>
            </optional>

            <optional>
              <element name="UserMetadata">
                <oneOrMore>
                  <element name="MetadataEntry">
                    <element name="Name">
                      <data type="string"/>
                    </element>
                    <element name="Value">
                      <data type="string"/>
                    </element>
                  </element>
                </oneOrMore>
              </element>
            </optional>

          </element>
        </element>
      </optional>
    </element>
  </start>
</grammar>